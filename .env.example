# Copy to .env and fill in (never commit .env)

DISCORD_BOT_TOKEN=your_bot_token_here
GUILD_ID=your_server_id_here
PLAYER_ROLE_ID=your_player_role_id_here

# Comma-separated message IDs for the 4 pinned onboarding messages (in order):
# welcome, start-here, rules-and-etiquette, dice-rules
ONBOARDING_MESSAGE_IDS=0,0,0,0

# Emoji users click to mark a channel complete (default: ✅)
ONBOARDING_EMOJI=✅

# Optional: remove Player role if they un-react from a checkpoint
REVOKE_ON_UNREACT=false
